{
  "opencollection": "1.0.0",
  "info": {
    "name": "Render Public Audit Logs Events API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.render.com/v1/events/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path",
                "description": "The ID of the event"
              }
            ]
          },
          "docs": "Retrieve the details of a particular event\n"
        }
      ]
    }
  ],
  "bundled": true
}