        {
          "info": {
            "name": "Delete service",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.render.com/v1/services/:serviceId",
            "params": [
              {
                "name": "serviceId",
                "value": "",
                "type": "path",
                "description": "The ID of the service"
              }
            ]
          },
          "docs": "Delete the service with the provided ID.\n"
        },
        {
          "info": {
            "name": "Purge Web Service Cache",
            "type": "http"
