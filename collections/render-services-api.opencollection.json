                "name": "type",
                "value": "",
                "type": "query",
                "description": "The type of event to filter to"
              },
              {
                "name": "startTime",
                "value": "",
                "type": "query",
                "description": "Epoch/Unix timestamp of start of time range to return. Defaults to `now() - 1 hour`."
