        },
        {
          "info": {
            "name": "Add or update environment variable",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.render.com/v1/services/:serviceId/env-vars/:envVarKey",
            "params": [
              {
                "name": "serviceId",
                "value": "",
                "type": "path",
                "description": "The ID of the service"
              },
              {
                "name": "envVarKey",
                "value": "",
                "type": "path",
                "description": "The name of the environment variable"
